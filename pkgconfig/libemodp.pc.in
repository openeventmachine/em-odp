prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: libemodp
Description: The Event Machine library
Version: @EM_VERSION_PKGCONFIG@
Requires: @libodp_name@
Requires.private: libconfig @libodphelper_name@
Libs: -L${libdir} -lemodp

Cflags: -I${includedir} \
        -DEM_CLI=@EM_CLI@
