# EditorConfig
root = true

[*]
indent_style = tab
tab_width = 8
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C/H source files: 100-column limit
[*.{c,h}]
max_line_length = 100

# Markdown files (and the CHANGELOG/README symlinks to their .md
# targets): don't trim trailing whitespace, used for formatting
[{CHANGELOG,README,*.md}]
trim_trailing_whitespace = false
